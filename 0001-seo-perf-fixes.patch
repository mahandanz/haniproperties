-<script>
-/* ============================================================
-   INVESTOR CORNER DATA
-   Reads live from investor-listings.csv, sitting next to this
-   HTML file. The CSV uses the friendly display headers from the
-   investor sheet export (e.g. "Price (RM)", "CF Rating (Best
-   Case)") -- COLMAP below maps them to the internal field names
-   this page works with. To refresh: overwrite investor-listings.csv
-   with a new export, no need to touch this page at all.
-
-   Friendly headers currently mapped (v13 schema): Project, Area,
-   Zone, Type, Bed, Bath, Size (sqft), Tenure, Price (RM),
-   Installment (RM/mo), Rental Fully, CF Fully, Yield% Fully,
-   Equity 10yr (RM), Equity Gain 10yr Net of Selling Cost (RM),
-   CF Rating (Best Case), Date Added, Code
-   ============================================================ */
-let DEALS = [];
-
-const WA_BASE = 'https://wa.me/60125459182?text=';
-
-function wa(text) { return WA_BASE + encodeURIComponent(text); }
-
-function fmt(n) { return 'RM ' + Number(n).toLocaleString('en-MY'); }
-
-function toSlug(...parts) {
-  return parts.filter(Boolean).join('-').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
-}
-
-function parseCSV(text) {
-  const lines = text.trim().split(String.fromCharCode(10));
-  const TAB = String.fromCharCode(9);
-  const delim = lines[0].includes(TAB) ? TAB : ',';
-  function splitLine(line) {
-    if (delim === TAB) return line.split(TAB).map(v => v.trim());
-    const vals = [];
-    let cur = '', inQ = false;
-    for (let i = 0; i < line.length; i++) {
-      const ch = line[i];
-      if (ch === '"') {
-        if (inQ && line[i+1] === '"') { cur += '"'; i++; }
-        else inQ = !inQ;
-      } else if (ch === ',' && !inQ) {
-        vals.push(cur); cur = '';
-      } else {
-        cur += ch;
-      }
-    }
-    vals.push(cur);
-    return vals.map(v => v.trim());
-  }
-  const headers = splitLine(lines[0]);
-  return lines.slice(1).filter(l => l.trim()).map(line => {
-    const vals = splitLine(line);
-    const obj = {};
-    headers.forEach((h, i) => obj[h] = (vals[i] || '').trim());
-    return obj;
-  });
-}
-
-function isPositiveCF(row) {
-  return (row.cf_rating || '').includes('Strong');
-}
-
-function toNum(v) {
-  const n = parseFloat(String(v).replace(/,/g,''));
-  return isNaN(n) ? null : n;
-}
-
-function dealCard(r) {
-  const waText = `Hi Hani, I'm interested in ${r.project}, ${r.area} (RM${r.price.toLocaleString()}) from the Investor Corner — can you share the full numbers on this one?`;
-  const bedBath = (r.bed || r.bath) ? `<span class="pill">🛏 ${r.bed || '-'} bed · 🚿 ${r.bath || '-'} bath</span>` : '';
-  const sizePill = r.size ? `<span class="pill">${Number(r.size).toLocaleString()} sqft</span>` : '';
-  const withCF = r.equityGainNet10yr + (r.cumCfFully10yr || 0);
-  return `<div class="card" id="${toSlug(r.project, r.area, r.price)}">
-    <div class="card-body">
-      <div><span class="card-badge badge-strong">🟢 +${fmt(r.cfFully)}/mo Cashflow</span>${coaBadge(r)}</div>
-      <div><div class="card-name">${r.project}</div><div class="card-zone">${r.zone ? r.zone + ', ' : ''}${r.area}</div></div>
-      <div class="card-price">${fmt(r.price)}</div>
-      <div class="equity-block">
-        <div class="equity-row"><span class="equity-label">📈 Nett Profit After 10 Yrs (with rental income)</span><span class="equity-amt">${fmt(withCF)}</span></div>
-        <div class="equity-sub"><span>Without rental income</span><span>${fmt(r.equityGainNet10yr)}</span></div>
-      </div>
-      <div class="card-pills"><span class="pill">🏠 Est. Rental ${fmt(r.rentalFully)}/mo</span>${bedBath}${sizePill}<span class="pill">${r.type}</span><span class="pill">${r.tenure}</span></div>
-      <a href="${wa(waText)}" class="card-cta" target="_blank" rel="noopener noreferrer">💬 Ask Hani for the Full Numbers</a>
-    </div>
-  </div>`;
-}
-
-function coaBadge(r) {
-  if (!r.code) return '';
-  return `<span class="card-badge badge-coa">${r.code}</span>`;
-}
-
-function empty(msg) {
-  return `<div class="empty">${msg}</div>`;
-}
-
-function buildOptions() {
-  const areas = [...new Set(DEALS.map(r => r.area))].sort();
-  const types = [...new Set(DEALS.map(r => r.type))].sort();
-  const areaSel = document.getElementById('f-area');
-  areas.forEach(a => {
-    const opt = document.createElement('option');
-    opt.value = a; opt.textContent = a;
-    areaSel.appendChild(opt);
-  });
-  const typeSel = document.getElementById('f-type');
-  types.forEach(t => {
-    const opt = document.createElement('option');
-    opt.value = t; opt.textContent = t;
-    typeSel.appendChild(opt);
-  });
-}
-
-function applyFilters() {
-  const area = document.getElementById('f-area').value;
-  const type = document.getElementById('f-type').value;
-  const maxPrice = document.getElementById('f-price').value;
-  const equityRange = document.getElementById('f-equity').value;
-  const cfRange = document.getElementById('f-cf').value;
-
-  let cfMin = null, cfMax = null;
-  if (cfRange) {
-    const parts = cfRange.split('-');
-    cfMin = parseFloat(parts[0]);
-    cfMax = parseFloat(parts[1]);
-  }
-
-  let eqMin = null, eqMax = null;
-  if (equityRange) {
-    const parts = equityRange.split('-');
-    eqMin = parseFloat(parts[0]);
-    eqMax = parseFloat(parts[1]);
-  }
-
-  let filtered = DEALS.filter(r =>
-    (!area || r.area === area) &&
-    (!type || r.type === type) &&
-    (!maxPrice || r.price <= parseFloat(maxPrice)) &&
-    (cfMin === null || (r.cfFully >= cfMin && r.cfFully <= cfMax)) &&
-    (eqMin === null || (r.equityGainNet10yr >= eqMin && r.equityGainNet10yr <= eqMax))
-  );
-
-  // Default order: most extra money each month first
-  filtered = filtered.slice().sort((a, b) => b.cfFully - a.cfFully);
-
-  const grid = document.getElementById('grid-deals');
-  grid.innerHTML = filtered.length ? filtered.map(dealCard).join('') : empty('No units match your filters. Try widening your search, or ask Hani directly.');
-  document.getElementById('filter-count').textContent = `${filtered.length} unit${filtered.length !== 1 ? 's' : ''}`;
-}
-
-function resetFilters() {
-  ['f-area','f-type','f-price','f-equity','f-cf'].forEach(id => document.getElementById(id).value = '');
-  applyFilters();
-}
-
-function latestDate() {
-  let max = null;
-  DEALS.forEach(r => {
-    if (!r.dateAdded) return;
-    const parts = r.dateAdded.split('/');
-    if (parts.length !== 3) return;
-    const d = new Date(+parts[2], +parts[1]-1, +parts[0]);
-    if (!max || d > max) max = d;
-  });
-  if (!max) return;
-  document.getElementById('data-date').textContent = max.toLocaleDateString('en-MY', {day:'numeric', month:'short', year:'numeric'});
-}
-
-// Maps the friendly column headers used in the exported sheet
-// to the internal field names this page works with.
-const COLMAP = {
-  project: 'Project',
-  area: 'Area',
-  zone: 'Zone',
-  type: 'Type',
-  bed: 'Bed',
-  bath: 'Bath',
-  size: 'Size (sqft)',
-  tenure: 'Tenure',
-  price: 'Price (RM)',
-  installment: 'Installment (RM/mo)',
-  rental_fully: 'Rental Fully',
-  cf_fully: 'CF Fully',
-  yield_fully: 'Yield% Fully',
-  equity_10yr: 'Equity 10yr (RM)',
-  cum_cf_unfurnished_10yr: 'Cumulative CF Unfurnished 10yr (RM)',
-  cum_cf_partial_10yr: 'Cumulative CF Partial 10yr (RM)',
-  cum_cf_fully_10yr: 'Cumulative CF Fully 10yr (RM)',
-  selling_cost_10yr: 'Selling Cost 10yr (RM)',
-  equity_gain_net_10yr: 'Equity Gain 10yr Net of Selling Cost (RM)',
-  cf_rating: 'CF Rating (Best Case)',
-  date_added: 'Date Added',
-  code: 'Code'
-};
-
-function mapRow(raw) {
-  const out = {};
-  Object.keys(COLMAP).forEach(key => { out[key] = raw[COLMAP[key]]; });
-  return out;
-}
-
-fetch('investor-listings.csv')
-  .then(r => r.text())
-  .then(text => {
-    const rawRows = parseCSV(text).map(mapRow);
-    const rows = rawRows.filter(isPositiveCF).filter(r => toNum(r.price) === null || toNum(r.price) <= 1000000);
-    DEALS = rows.map(r => ({
-      project: r.project,
-      area: r.area,
-      zone: r.zone,
-      type: r.type,
-      bed: toNum(r.bed),
-      bath: toNum(r.bath),
-      size: toNum(r.size),
-      tenure: r.tenure,
-      price: toNum(r.price),
-      rentalFully: toNum(r.rental_fully),
-      cfFully: toNum(r.cf_fully),
-      yieldFully: toNum(r.yield_fully),
-      equityGainNet10yr: toNum(r.equity_gain_net_10yr),
-      cumCfFully10yr: toNum(r.cum_cf_fully_10yr),
-      installment: toNum(r.installment),
-      dateAdded: r.date_added,
-      code: r.code
-    })).filter(r => r.project && r.price && r.rentalFully !== null && r.cfFully !== null && r.equityGainNet10yr !== null && r.yieldFully !== null);
-
-    buildOptions();
-    latestDate();
-    applyFilters();
-
-    const prices = DEALS.map(d => d.price).filter(Boolean);
-    if (prices.length) {
-      const min = Math.min(...prices), max = Math.max(...prices);
-      document.getElementById('hero-summary-stat').textContent =
-        `${DEALS.length} units currently show positive cashflow, from RM${min.toLocaleString()} to RM${max.toLocaleString()}.`;
-    }
-  })
-  .catch((e) => {
-    console.error('Fetch error:', e);
-    document.getElementById('grid-deals').innerHTML = empty('Unable to load units right now. Please try again, or WhatsApp Hani directly.');
-  });
-</script>
-</body>
